<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Analyze Repository | CodeOrigin AI</title>

    <!-- Bootstrap -->
    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >

    <!-- Bootstrap Icons -->
    <link
        rel="stylesheet"
        href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
    >

    <!-- Custom CSS -->
        <link rel="stylesheet" href="/css/analyze.css">
</head>

<body>

    <%- include('../layouts/navbar') %>

<!-- =====================================================
     MAIN
===================================================== -->

<main class="analyze-page">


<!-- =====================================================
     PAGE INTRO
===================================================== -->

<section class="page-intro">

    <div class="container">

        <div class="intro-content">

            <div class="status-label">
                <span></span>
                MULTI-MODAL ANALYSIS ENGINE READY
            </div>

            <h1>
                Analyze a
                <span>Repository.</span>
            </h1>

            <p>
                Investigate source code, structural patterns and
                repository behaviour to estimate whether the code
                is human-written or AI-generated.
            </p>

        </div>

    </div>

</section>


<!-- =====================================================
     REPOSITORY INPUT
===================================================== -->

<section class="repository-input-section">

    <div class="container">

        <div class="analysis-input-card">

            <div class="card-heading">

                <div>

                    <span class="mini-label">
                        STEP 01
                    </span>

                    <h2>
                        Connect Repository
                    </h2>

                    <p>
                        Enter a public GitHub repository URL to begin.
                    </p>

                </div>

                <div class="heading-icon">
                    <i class="bi bi-github"></i>
                </div>

            </div>


            <!-- GitHub Input -->

            <div class="github-input-wrapper">

                <div class="input-icon">
                    <i class="bi bi-link-45deg"></i>
                </div>

                <input
                    type="url"
                    id="repositoryUrl"
                    placeholder="https://github.com/username/repository"
                >

                <button
                    type="button"
                    class="scan-btn"
                    onclick="showRepository()"
                >
                    Scan Repository
                    <i class="bi bi-arrow-right"></i>
                </button>

            </div>


            <div class="input-hint">

                <span>
                    <i class="bi bi-shield-check"></i>
                    Public repositories supported
                </span>

                <span>
                    <i class="bi bi-lightning-charge"></i>
                    Fast repository scanning
                </span>

            </div>


            <!-- OR -->

            <div class="or-divider">

                <span>OR</span>

            </div>


            <!-- Upload -->

            <div class="upload-box">

                <div class="upload-icon">
                    <i class="bi bi-cloud-arrow-up"></i>
                </div>

                <h3>
                    Upload Repository
                </h3>

                <p>
                    Drop a ZIP file here or browse your computer
                </p>

                <label class="browse-btn">

                    Browse Files

                    <input
                        type="file"
                        hidden
                        accept=".zip"
                    >

                </label>

                <small>
                    Supported format: .ZIP
                </small>

            </div>

        </div>

    </div>

</section>


<!-- =====================================================
     REPOSITORY PREVIEW
===================================================== -->

<section
    class="repository-preview-section"
    id="repositoryPreview"
>

    <div class="container">

        <div class="section-top">

            <div>

                <span class="mini-label">
                    REPOSITORY DETECTED
                </span>

                <h2>
                    Repository Preview
                </h2>

            </div>

            <span class="detected-badge">
                <span></span>
                Repository Found
            </span>

        </div>


        <div class="repository-preview-card">

            <!-- Repository Info -->

            <div class="repo-main-info">

                <div class="repo-icon">
                    <i class="bi bi-github"></i>
                </div>

                <div>

                    <h3>
                        Smart-Farmer
                    </h3>

                    <p>
                        github.com/username/smart-farmer
                    </p>

                </div>

            </div>


            <!-- Repository Stats -->

            <div class="repo-stats">

                <div class="repo-stat">

                    <span>LANGUAGE</span>

                    <strong>
                        JavaScript
                    </strong>

                </div>


                <div class="repo-stat">

                    <span>FILES</span>

                    <strong>
                        42
                    </strong>

                </div>


                <div class="repo-stat">

                    <span>LINES OF CODE</span>

                    <strong>
                        4,820
                    </strong>

                </div>


                <div class="repo-stat">

                    <span>COMMITS</span>

                    <strong>
                        86
                    </strong>

                </div>


                <div class="repo-stat">

                    <span>CONTRIBUTORS</span>

                    <strong>
                        03
                    </strong>

                </div>

            </div>


            <button class="start-analysis-btn">

                <i class="bi bi-cpu"></i>

                Start Multi-Modal Analysis

                <i class="bi bi-arrow-right"></i>

            </button>

        </div>

    </div>

</section>


<!-- =====================================================
     ANALYSIS CONFIGURATION
===================================================== -->

<section class="configuration-section">

    <div class="container">

        <div class="section-top">

            <div>

                <span class="mini-label">
                    STEP 02
                </span>

                <h2>
                    Analysis Configuration
                </h2>

                <p>
                    Select the intelligence layers used during analysis.
                </p>

            </div>

        </div>


        <div class="configuration-grid">


            <!-- Code -->

            <div class="config-card selected">

                <div class="config-header">

                    <div class="config-icon purple">
                        <i class="bi bi-code-slash"></i>
                    </div>

                    <div class="checkbox checked">
                        <i class="bi bi-check"></i>
                    </div>

                </div>

                <h3>
                    Source Code
                </h3>

                <p>
                    Analyze lexical, statistical and stylistic
                    characteristics of source code.
                </p>

                <div class="config-tags">

                    <span>LOC</span>
                    <span>Tokens</span>
                    <span>Complexity</span>

                </div>

            </div>


            <!-- AST -->

            <div class="config-card selected">

                <div class="config-header">

                    <div class="config-icon cyan">
                        <i class="bi bi-diagram-3"></i>
                    </div>

                    <div class="checkbox checked">
                        <i class="bi bi-check"></i>
                    </div>

                </div>

                <h3>
                    AST Structure
                </h3>

                <p>
                    Extract abstract syntax tree and structural
                    characteristics of the repository.
                </p>

                <div class="config-tags">

                    <span>AST Nodes</span>
                    <span>Depth</span>
                    <span>Flow</span>

                </div>

            </div>


            <!-- Git -->

            <div class="config-card selected">

                <div class="config-header">

                    <div class="config-icon green">
                        <i class="bi bi-git"></i>
                    </div>

                    <div class="checkbox checked">
                        <i class="bi bi-check"></i>
                    </div>

                </div>

                <h3>
                    Git Behaviour
                </h3>

                <p>
                    Analyze commits, contributors, code churn
                    and repository evolution.
                </p>

                <div class="config-tags">

                    <span>Commits</span>
                    <span>Churn</span>
                    <span>Evolution</span>

                </div>

            </div>


            <!-- ML -->

            <div class="config-card selected">

                <div class="config-header">

                    <div class="config-icon orange">
                        <i class="bi bi-cpu"></i>
                    </div>

                    <div class="checkbox checked">
                        <i class="bi bi-check"></i>
                    </div>

                </div>

                <h3>
                    ML Classification
                </h3>

                <p>
                    Fuse extracted features and classify code
                    origin with confidence scoring.
                </p>

                <div class="config-tags">

                    <span>Fusion</span>
                    <span>Classification</span>
                    <span>Confidence</span>

                </div>

            </div>

        </div>

    </div>

</section>


<!-- =====================================================
     WHAT WILL BE ANALYZED
===================================================== -->

<section class="modalities-section">

    <div class="container">

        <div class="section-heading-center">

            <span class="mini-label">
                MULTI-MODAL INTELLIGENCE
            </span>

            <h2>
                What Will Be Analyzed?
            </h2>

            <p>
                CodeOrigin AI combines multiple repository signals
                before generating a final prediction.
            </p>

        </div>


        <div class="modality-grid">

            <div class="modality-card">

                <span class="modality-number">
                    01
                </span>

                <i class="bi bi-file-code"></i>

                <h3>
                    Source Code
                </h3>

                <p>
                    Lexical and statistical patterns
                    extracted from source files.
                </p>

                <div class="modality-line"></div>

                <small>
                    Tokens · LOC · Comments · Naming
                </small>

            </div>


            <div class="modality-card">

                <span class="modality-number">
                    02
                </span>

                <i class="bi bi-diagram-3"></i>

                <h3>
                    AST Structure
                </h3>

                <p>
                    Structural and syntactic patterns
                    represented through AST analysis.
                </p>

                <div class="modality-line"></div>

                <small>
                    Nodes · Depth · Control Flow
                </small>

            </div>


            <div class="modality-card">

                <span class="modality-number">
                    03
                </span>

                <i class="bi bi-git"></i>

                <h3>
                    Git Behaviour
                </h3>

                <p>
                    Development behaviour captured from
                    repository history.
                </p>

                <div class="modality-line"></div>

                <small>
                    Commits · Churn · Contributors
                </small>

            </div>


            <div class="modality-card">

                <span class="modality-number">
                    04
                </span>

                <i class="bi bi-cpu"></i>

                <h3>
                    ML Intelligence
                </h3>

                <p>
                    Feature fusion and machine learning
                    classification generate the prediction.
                </p>

                <div class="modality-line"></div>

                <small>
                    Fusion · Prediction · Confidence
                </small>

            </div>

        </div>

    </div>

</section>


<!-- =====================================================
     ANALYSIS PIPELINE
===================================================== -->

<section class="pipeline-section">

    <div class="container">

        <div class="section-heading-center">

            <span class="mini-label">
                SYSTEM PIPELINE
            </span>

            <h2>
                From Repository to Prediction
            </h2>

            <p>
                Every repository passes through multiple processing
                stages before the final classification.
            </p>

        </div>


        <div class="pipeline">

            <div class="pipeline-step active">

                <div class="pipeline-number">
                    01
                </div>

                <div class="pipeline-icon">
                    <i class="bi bi-github"></i>
                </div>

                <h3>
                    Repository
                </h3>

                <span>
                    Input
                </span>

            </div>


            <div class="pipeline-connector"></div>


            <div class="pipeline-step">

                <div class="pipeline-number">
                    02
                </div>

                <div class="pipeline-icon">
                    <i class="bi bi-search"></i>
                </div>

                <h3>
                    Extraction
                </h3>

                <span>
                    Scan Files
                </span>

            </div>


            <div class="pipeline-connector"></div>


            <div class="pipeline-step">

                <div class="pipeline-number">
                    03
                </div>

                <div class="pipeline-icon">
                    <i class="bi bi-sliders"></i>
                </div>

                <h3>
                    Features
                </h3>

                <span>
                    Engineering
                </span>

            </div>


            <div class="pipeline-connector"></div>


            <div class="pipeline-step">

                <div class="pipeline-number">
                    04
                </div>

                <div class="pipeline-icon">
                    <i class="bi bi-layers"></i>
                </div>

                <h3>
                    Fusion
                </h3>

                <span>
                    Multi-Modal
                </span>

            </div>


            <div class="pipeline-connector"></div>


            <div class="pipeline-step">

                <div class="pipeline-number">
                    05
                </div>

                <div class="pipeline-icon">
                    <i class="bi bi-cpu"></i>
                </div>

                <h3>
                    ML Model
                </h3>

                <span>
                    Classification
                </span>

            </div>


            <div class="pipeline-connector"></div>


            <div class="pipeline-step result">

                <div class="pipeline-number">
                    06
                </div>

                <div class="pipeline-icon">
                    <i class="bi bi-graph-up-arrow"></i>
                </div>

                <h3>
                    Prediction
                </h3>

                <span>
                    Result
                </span>

            </div>

        </div>

    </div>

</section>


<!-- =====================================================
     ANALYSIS ACTION
===================================================== -->

<section class="analysis-action-section">

    <div class="container">

        <div class="action-card">

            <div class="action-content">

                <span class="mini-label">
                    READY TO ANALYZE
                </span>

                <h2>
                    Start Repository Analysis
                </h2>

                <p>
                    The selected repository will be processed through
                    source-code, AST and Git intelligence layers.
                </p>

            </div>


            <button class="final-analyze-btn">

                <i class="bi bi-cpu"></i>

                Analyze Repository

                <i class="bi bi-arrow-right"></i>

            </button>

        </div>

    </div>

</section>


</main>


<!-- =====================================================
     FOOTER
===================================================== -->

<footer class="codeorigin-footer">

    <div class="footer-container">

        <div class="footer-main">

            <div class="footer-brand">

                <a href="/" class="footer-logo">

                    <span class="logo-symbol">
                        &lt;/&gt;
                    </span>

                    <span>
                        CODEORIGIN <b>AI</b>
                    </span>

                </a>

                <h3>
                    Repository-Level Code Intelligence
                </h3>

                <p>
                    A multi-modal machine learning framework for
                    detecting human and AI-generated source code.
                </p>

            </div>


            <div class="footer-links">

                <h4>
                    QUICK LINKS
                </h4>

                <a href="/">
                    Home
                </a>

                <a href="/analyze">
                    Analyze
                </a>

                <a href="/reports">
                    Reports
                </a>

                <a href="/research">
                    Research
                </a>

                <a href="/about">
                    About
                </a>

            </div>

        </div>


        <div class="footer-divider"></div>


        <div class="footer-status">

            <div class="status-item">

                <span class="status-dot"></span>

                SYSTEM ONLINE

            </div>

            <div class="status-item">

                <span class="status-dot"></span>

                ML ENGINE READY

            </div>

            <div class="status-item">

                <span class="status-dot"></span>

                PYTHON SERVICE READY

            </div>

        </div>


        <div class="footer-bottom">

            <span>
                © 2026 CodeOrigin AI
            </span>

            <span class="footer-project">
                Major Project
            </span>

        </div>

    </div>

</footer>


<script>

    const navToggle = document.querySelector('.nav-toggle');
    const navLinks = document.querySelector('.nav-links, #mainNav');

    if (navToggle && navLinks) {
        navToggle.addEventListener('click', () => {
            const menuClass = navLinks.classList.contains('navbar-collapse') ? 'show' : 'open';
            const isOpen = navLinks.classList.toggle(menuClass);
            navToggle.setAttribute('aria-expanded', isOpen);
        });
    }

    function showRepository() {

        const input = document.getElementById("repositoryUrl");

        const preview =
            document.getElementById("repositoryPreview");

        if (input.value.trim() === "") {

            alert("Please enter a GitHub repository URL.");

            return;

        }

        preview.classList.add("show");

        preview.scrollIntoView({
            behavior: "smooth",
            block: "center"
        });

    }

</script>

</body>
</html>
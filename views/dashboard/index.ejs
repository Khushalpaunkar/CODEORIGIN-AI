<script>
    const chartPaths = {
        commits: 'M0 250 L80 220 L160 235 L240 180 L320 200 L400 140 L480 165 L560 100 L640 125 L720 80 L800 110 L880 55 L1000 75',
        added: 'M0 265 L80 230 L160 245 L240 210 L320 175 L400 190 L480 125 L560 145 L640 95 L720 120 L800 75 L880 95 L1000 45',
        removed: 'M0 210 L80 235 L160 190 L240 220 L320 145 L400 175 L480 130 L560 165 L640 105 L720 145 L800 90 L880 120 L1000 80'
    };

    document.querySelectorAll('.chart-controls button').forEach((button) => {
        button.addEventListener('click', () => {
            document.querySelectorAll('.chart-controls button').forEach((item) => item.classList.remove('active'));
            button.classList.add('active');
            document.querySelector('.chart-path').setAttribute('d', chartPaths[button.dataset.series]);
            document.querySelector('.chart-fill').setAttribute('d', `${chartPaths[button.dataset.series]} L1000 300 L0 300 Z`);
        });
    });
</script>


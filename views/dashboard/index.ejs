<!-- =====================================================
     FRAMEWORK
===================================================== -->

<section class="framework-section" id="framework">

    <div class="container-fluid px-lg-5">

        <div class="section-heading-center">

            <span class="section-label">
                DETECTION PIPELINE
            </span>

            <h2>
                From Repository to Intelligence
            </h2>

            <p>
                Multiple repository-level signals are transformed
                into meaningful features before reaching the
                machine learning classifier.
            </p>

        </div>


        <div class="framework-flow">

            <div class="framework-step">

                <div class="step-number">01</div>

                <div class="step-icon">
                    <i class="bi bi-github"></i>
                </div>

                <h3>Repository Input</h3>

                <p>
                    GitHub repository or source-code upload.
                </p>

            </div>


            <div class="flow-line"></div>


            <div class="framework-step">

                <div class="step-number">02</div>

                <div class="step-icon">
                    <i class="bi bi-code-slash"></i>
                </div>

                <h3>Source Analysis</h3>

                <p>
                    Extract code-level statistical features.
                </p>

            </div>


            <div class="flow-line"></div>


            <div class="framework-step">

                <div class="step-number">03</div>

                <div class="step-icon">
                    <i class="bi bi-diagram-3"></i>
                </div>

                <h3>AST Analysis</h3>

                <p>
                    Study structural and syntax patterns.
                </p>

            </div>


            <div class="flow-line"></div>


            <div class="framework-step">

                <div class="step-number">04</div>

                <div class="step-icon">
                    <i class="bi bi-clock-history"></i>
                </div>

                <h3>Repository Behaviour</h3>

                <p>
                    Analyze commits and code evolution.
                </p>

            </div>


            <div class="flow-line"></div>


            <div class="framework-step active-step">

                <div class="step-number">05</div>

                <div class="step-icon">
                    <i class="bi bi-cpu"></i>
                </div>

                <h3>ML Prediction</h3>

                <p>
                    Fuse features and estimate code origin.
                </p>

            </div>

        </div>

    </div>

</section>


<!-- =====================================================
     MULTI MODAL INTELLIGENCE
===================================================== -->

<section class="intelligence-section">

    <div class="container-fluid px-lg-5">

        <div class="section-heading">

            <span class="section-label">
                MULTI-MODAL INTELLIGENCE
            </span>

            <h2>
                Multiple Signals.<br>
                One Prediction.
            </h2>

            <p>
                Instead of depending on a single detector,
                CodeOrigin AI combines multiple forms of
                repository evidence.
            </p>

        </div>


        <div class="intelligence-grid">

            <article class="intelligence-card code-card">

                <div class="card-top">

                    <div class="large-card-icon">
                        <i class="bi bi-code-slash"></i>
                    </div>

                    <span class="card-index">01</span>

                </div>

                <h3>Code Intelligence</h3>

                <p>
                    Statistical and lexical characteristics
                    extracted directly from source code.
                </p>

                <div class="feature-tags">
                    <span>LOC</span>
                    <span>Tokens</span>
                    <span>Comments</span>
                    <span>Complexity</span>
                    <span>Naming</span>
                </div>

            </article>


            <article class="intelligence-card ast-card">

                <div class="card-top">

                    <div class="large-card-icon">
                        <i class="bi bi-diagram-3"></i>
                    </div>

                    <span class="card-index">02</span>

                </div>

                <h3>Structural Intelligence</h3>

                <p>
                    Abstract syntax tree and structural
                    patterns of the repository.
                </p>

                <div class="feature-tags">
                    <span>AST Nodes</span>
                    <span>Control Flow</span>
                    <span>Nesting</span>
                    <span>Syntax</span>
                </div>

            </article>


            <article class="intelligence-card git-card">

                <div class="card-top">

                    <div class="large-card-icon">
                        <i class="bi bi-git"></i>
                    </div>

                    <span class="card-index">03</span>

                </div>

                <h3>Repository Intelligence</h3>

                <p>
                    Development behaviour captured through
                    Git history and repository evolution.
                </p>

                <div class="feature-tags">
                    <span>Commits</span>
                    <span>Contributors</span>
                    <span>Churn</span>
                    <span>Evolution</span>
                </div>

            </article>


            <article class="intelligence-card model-card">

                <div class="card-top">

                    <div class="large-card-icon">
                        <i class="bi bi-cpu"></i>
                    </div>

                    <span class="card-index">04</span>

                </div>

                <h3>Model Intelligence</h3>

                <p>
                    Feature fusion and classification generate
                    probability and confidence scores.
                </p>

                <div class="feature-tags">
                    <span>Feature Fusion</span>
                    <span>Classification</span>
                    <span>Probability</span>
                    <span>Confidence</span>
                </div>

            </article>

        </div>

    </div>

</section>



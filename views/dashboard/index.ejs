            </div>


            <div class="comparison-side ai-side">

                <div class="comparison-title">

                    <div class="comparison-icon">
                        <i class="bi bi-stars"></i>
                    </div>

                    <div>
                        <small>ORIGIN TYPE</small>
                        <h3>AI-Generated Code</h3>
                    </div>

                </div>


                <ul class="signal-list">

                    <li>
                        <i class="bi bi-check2"></i>
                        High structural consistency
                    </li>

                    <li>
                        <i class="bi bi-check2"></i>
                        Repeated patterns
                    </li>

                    <li>
                        <i class="bi bi-check2"></i>
                        Uniform formatting
                    </li>

                    <li>
                        <i class="bi bi-check2"></i>
                        Generated code blocks
                    </li>

                    <li>
                        <i class="bi bi-check2"></i>
                        Characteristic complexity
                    </li>

                </ul>

            </div>

        </div>


        <div class="disclaimer">
            <i class="bi bi-info-circle"></i>

            These indicators represent model signals and are
            not absolute proof of authorship.
        </div>

    </div>

</section>



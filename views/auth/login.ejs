<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title><%= pageTitle %></title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >

    <link
        rel="stylesheet"
        href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
    >

    <link rel="stylesheet" href="/css/auth.css">
</head>

<body>

    <%- include('../layouts/navbar') %>

    <main class="auth-page">

        <div class="auth-glow auth-glow-left"></div>
        <div class="auth-glow auth-glow-right"></div>
        <div class="auth-ring"></div>

        <div class="auth-wrap">

            <div class="auth-card">

                <div class="auth-card-heading">

                    <span class="auth-label">
                        <i class="bi bi-shield-lock"></i>
                        SECURE ACCESS
                    </span>

                    <h1>
                        Welcome
                        <span>Back.</span>
                    </h1>

                    <p>
                        Sign in to continue to CodeOrigin AI and
                        start analyzing repositories.
                    </p>

                </div>

                <% if (flashMsg) { %>
                    <% if (flashMsg.type === 'success') { %>
                        <div class="auth-alert success">
                            <i class="bi bi-check-circle-fill"></i>
                            <span><%= flashMsg.message %></span>
                        </div>
                    <% } else { %>
                        <div class="auth-alert error">
                            <i class="bi bi-exclamation-circle-fill"></i>
                            <span><%= flashMsg.message %></span>
                        </div>
                    <% } %>
                <% } %>

                <form action="/auth/login" method="POST" novalidate>

                    <input type="hidden" name="next" value="<%= next %>">

                    <div class="auth-field">

                        <label for="identifier">
                            Email / Username
                        </label>

                        <div class="auth-input<%= form.identifier ? ' has-value' : '' %>">

                            <i class="bi bi-person"></i>

                            <input
                                type="text"
                                id="identifier"
                                name="identifier"
                                placeholder="you@example.com or username"
                                value="<%= form.identifier %>"
                                autocomplete="username"
                            >

                        </div>

                        <% if (errors.identifier) { %>
                            <span class="field-error">
                                <i class="bi bi-exclamation-diamond"></i>
                                <%= errors.identifier %>
                            </span>
                        <% } %>

                    </div>


                    <div class="auth-field">

                        <label for="password">
                            Password
                        </label>

                        <div class="auth-input">

                            <i class="bi bi-lock"></i>

                            <input
                                type="password"
                                id="password"
                                name="password"
                                placeholder="Enter your password"
                                autocomplete="current-password"
                            >

                            <button
                                type="button"
                                class="password-toggle"
                                data-password-toggle
                                aria-label="Show password"
                            >
                                <i class="bi bi-eye"></i>
                            </button>

                        </div>

                        <% if (errors.password) { %>
                            <span class="field-error">
                                <i class="bi bi-exclamation-diamond"></i>
                                <%= errors.password %>
                            </span>
                        <% } %>

                    </div>

                    <button type="submit" class="auth-submit">
                        <span>Sign In</span>
                        <i class="bi bi-arrow-right"></i>
                    </button>

                </form>

                <div class="auth-switch">

                    <span>Don't have an account?</span>

                    <a href="/auth/register">Create Account</a>

                </div>

            </div>

        </div>

    </main>

    <%- include('../layouts/footer') %>

    <script>
        document.querySelectorAll('[data-password-toggle]').forEach((btn) => {
            btn.addEventListener('click', () => {
                const input = btn.closest('.auth-input').querySelector('input');
                const isPassword = input.type === 'password';
                input.type = isPassword ? 'text' : 'password';
                btn.querySelector('i').className = isPassword
                    ? 'bi bi-eye-slash'
                    : 'bi bi-eye';
            });
        });
    </script>

</body>
</html>
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title><%= pageTitle %></title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >

    <link
        rel="stylesheet"
        href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
    >

    <link rel="stylesheet" href="/css/auth.css">
</head>

<body>

    <%- include('../layouts/navbar') %>

    <main class="auth-page">

        <div class="auth-glow auth-glow-left"></div>
        <div class="auth-glow auth-glow-right"></div>
        <div class="auth-ring"></div>

        <div class="auth-wrap">

            <div class="auth-card">

                <div class="auth-card-heading">

                    <span class="auth-label">
                        <i class="bi bi-person-plus"></i>
                        CREATE ACCOUNT
                    </span>

                    <h1>
                        Create Your
                        <span>Account.</span>
                    </h1>

                    <p>
                        Start analyzing repositories with
                        CodeOrigin AI.
                    </p>

                </div>

                <% if (flashMsg) { %>
                    <% if (flashMsg.type === 'success') { %>
                        <div class="auth-alert success">
                            <i class="bi bi-check-circle-fill"></i>
                            <span><%= flashMsg.message %></span>
                        </div>
                    <% } else { %>
                        <div class="auth-alert error">
                            <i class="bi bi-exclamation-circle-fill"></i>
                            <span><%= flashMsg.message %></span>
                        </div>
                    <% } %>
                <% } %>

                <% if (errors.form) { %>
                    <div class="auth-alert error">
                        <i class="bi bi-exclamation-circle-fill"></i>
                        <span><%= errors.form %></span>
                    </div>
                <% } %>

                <form action="/auth/register" method="POST" novalidate>

                    <div class="auth-field">

                        <label for="name">Full Name</label>

                        <div class="auth-input<%= form.name ? ' has-value' : '' %>">

                            <i class="bi bi-person-badge"></i>

                            <input
                                type="text"
                                id="name"
                                name="name"
                                placeholder="e.g. Khushal Paunkar"
                                value="<%= form.name %>"
                                autocomplete="name"
                            >

                        </div>

                        <% if (errors.name) { %>
                            <span class="field-error">
                                <i class="bi bi-exclamation-diamond"></i>
                                <%= errors.name %>
                            </span>
                        <% } %>

                    </div>


                    <div class="auth-field">

                        <label for="email">Email Address</label>

                        <div class="auth-input<%= form.email ? ' has-value' : '' %>">

                            <i class="bi bi-envelope"></i>

                            <input
                                type="email"
                                id="email"
                                name="email"
                                placeholder="you@example.com"
                                value="<%= form.email %>"
                                autocomplete="email"
                            >

                        </div>

                        <% if (errors.email) { %>
                            <span class="field-error">
                                <i class="bi bi-exclamation-diamond"></i>
                                <%= errors.email %>
                            </span>
                        <% } %>

                    </div>


                    <div class="auth-field">

                        <label for="username">Username</label>

                        <div class="auth-input<%= form.username ? ' has-value' : '' %>">

                            <i class="bi bi-at"></i>

                            <input
                                type="text"
                                id="username"
                                name="username"
                                placeholder="3-20 chars, letters / numbers / _"
                                value="<%= form.username %>"
                                autocomplete="username"
                            >

                        </div>

                        <% if (errors.username) { %>
                            <span class="field-error">
                                <i class="bi bi-exclamation-diamond"></i>
                                <%= errors.username %>
                            </span>
                        <% } %>

                    </div>


                    <div class="auth-field">

                        <label for="password">Password</label>

                        <div class="auth-input">

                            <i class="bi bi-lock"></i>

                            <input
                                type="password"
                                id="password"
                                name="password"
                                placeholder="Minimum 8 characters"
                                autocomplete="new-password"
                                data-strength-input
                            >

                            <button
                                type="button"
                                class="password-toggle"
                                data-password-toggle
                                aria-label="Show password"
                            >
                                <i class="bi bi-eye"></i>
                            </button>

                        </div>

                        <div class="password-strength" data-strength-meter>

                            <div class="strength-segments">
                                <span></span>
                                <span></span>
                                <span></span>
                            </div>

                            <small class="strength-label">
                                Password strength
                            </small>

                        </div>

                        <% if (errors.password) { %>
                            <span class="field-error">
                                <i class="bi bi-exclamation-diamond"></i>
                                <%= errors.password %>
                            </span>
                        <% } %>

                    </div>


                    <div class="auth-field">

                        <label for="confirmPassword">Confirm Password</label>

                        <div class="auth-input">

                            <i class="bi bi-lock-fill"></i>

                            <input
                                type="password"
                                id="confirmPassword"
                                name="confirmPassword"
                                placeholder="Re-enter your password"
                                autocomplete="new-password"
                            >

                            <button
                                type="button"
                                class="password-toggle"
                                data-password-toggle
                                aria-label="Show password"
                            >
                                <i class="bi bi-eye"></i>
                            </button>

                        </div>

                        <% if (errors.confirmPassword) { %>
                            <span class="field-error">
                                <i class="bi bi-exclamation-diamond"></i>
                                <%= errors.confirmPassword %>
                            </span>
                        <% } %>

                    </div>

                    <button type="submit" class="auth-submit">
                        <span>Create Account</span>
                        <i class="bi bi-arrow-right"></i>
                    </button>

                </form>

                <div class="auth-switch">

                    <span>Already have an account?</span>

                    <a href="/auth/login">Sign In</a>

                </div>

            </div>

        </div>

    </main>

    <%- include('../layouts/footer') %>

    <script>
        document.querySelectorAll('[data-password-toggle]').forEach((btn) => {
            btn.addEventListener('click', () => {
                const input = btn.closest('.auth-input').querySelector('input');
                const isPassword = input.type === 'password';
                input.type = isPassword ? 'text' : 'password';
                btn.querySelector('i').className = isPassword
                    ? 'bi bi-eye-slash'
                    : 'bi bi-eye';
            });
        });

        const strengthInput = document.querySelector('[data-strength-input]');
        const strengthMeter = document.querySelector('[data-strength-meter]');

        if (strengthInput && strengthMeter) {
            const segments = strengthMeter.querySelectorAll('.strength-segments span');
            const label = strengthMeter.querySelector('.strength-label');

            strengthInput.addEventListener('input', () => {
                const value = strengthInput.value;
                const length = value.length;

                let score = 0;
                let text = 'Password strength';

                if (length >= 8) score += 1;
                if (length >= 10) score += 1;
                if (/[a-z]/.test(value) && /[A-Z]/.test(value)) score += 1;
                if (/\d/.test(value) || /[^a-zA-Z0-9]/.test(value)) score += 1;

                score = Math.max(0, Math.min(3, length === 0 ? 0 : Math.max(1, score > 3 ? 3 : score)));

                strengthMeter.classList.remove('level-1');
                strengthMeter.classList.remove('level-2');
                strengthMeter.classList.remove('level-3');

                if (length === 0) {
                    text = 'Password strength';
                } else if (score === 1) {
                    text = 'Weak';
                    strengthMeter.classList.add('level-1');
                } else if (score === 2) {
                    text = 'Fair';
                    strengthMeter.classList.add('level-2');
                } else {
                    text = 'Strong';
                    strengthMeter.classList.add('level-3');
                }

                label.textContent = text;

                segments.forEach((segment, index) => {
                    segment.classList.toggle('filled', index < score);
                });
            });
        }
    </script>

</body>
</html>